# Call variants using all BAM files produced by the batch.
make call
make[1]: Entering directory '/home/user/Documents/bioinfo/cdf'
mkdir -p vcf/
bcftools mpileup -d 100 --annotate 'INFO/AD,FORMAT/DP,FORMAT/AD,FORMAT/ADF,FORMAT/ADR,FORMAT/SP' -O u \
	-f fasta/CHC155.fasta \
	bam/*.bam | \
	bcftools call --ploidy 2 --annotate 'FORMAT/GQ' -mv -O u | \
	bcftools norm -f fasta/CHC155.fasta -d all -O u | \
	bcftools sort --write-index -O z -o vcf/variants.vcf.gz
bcftools stats vcf/variants.vcf.gz > vcf/variants.stats.txt
grep '^SN' vcf/variants.stats.txt
